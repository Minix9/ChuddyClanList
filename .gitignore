# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# The admin panel (admin.html, css/admin/, js/admin/) is published: it holds no keys,
# admins sign in with their own Supabase account and RLS limits writes to them.
# These admin-related files stay local:
admin PACKS.html
_backup/admin.original.html
js/admin/local-config.js
supabase_setup.sql

# Database backups
_backup/*.json

# Screenshots shared while working on the site
pictures/

# Personal auto-login admin (contains no key itself, but loads local-config.js)
admin-local.html

# Admin login SQL (contains your email)
supabase_admin_auth.sql

# All Supabase SQL files stay local
supabase_*.sql

# Admin package for other admins (send it directly, never push)
*.zip
